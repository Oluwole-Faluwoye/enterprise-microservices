pipeline {

    agent any

    parameters {

        booleanParam(
            name: 'RUN_OWASP_SCAN',
            defaultValue: false,
            description: 'Run OWASP Dependency Check scan'
        )

        string(
            name: 'PLATFORM_ENVIRONMENT',
            defaultValue: 'dev',
            description: 'Platform environment to deploy to'
        )
    }

    environment {

        AWS_REGION = "us-east-1"

        ACCOUNT_ID = "761018849945"

        IMAGE_NAME = "auth-service"

        IMAGE_TAG = "${BUILD_NUMBER}"

        ECR_REPO = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${IMAGE_NAME}"

        MIGRATION_PATH = "${IMAGE_NAME}/migrations/${GIT_COMMIT}"

        GITOPS_REPO = "git@github.com:Oluwole-Faluwoye/enterprise-platform-gitops.git"

        SONARQUBE_ENV = "sonarqube"

        SERVICE_DIR = "services/auth-service"
    }

    options {

        timestamps()

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20'
            )
        )

        ansiColor('xterm')
    }

    stages {

        stage('Checkout') {

            steps {

                echo "Checking out source code..."

                checkout scm

                echo "Git commit: ${GIT_COMMIT}"
            }
        }

        stage('Build & Unit Tests') {

            agent {

                docker {

                    image 'maven:3.9-eclipse-temurin-21'

                    args '--network devops-network -v $HOME/.m2:/root/.m2'

                    reuseNode true
                }
            }

            steps {

                dir("${SERVICE_DIR}") {

                    sh '''
                        mvn clean verify
                    '''
                }
            }

            post {

                always {

                    junit(
                        testResults: 'services/auth-service/target/surefire-reports/*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        stage('Platform Contract Validation') {

            agent {

                docker {

                    image 'maven:3.9-eclipse-temurin-21'

                    args '--network devops-network -v $HOME/.m2:/root/.m2'

                    reuseNode true
                }
            }

            steps {

                dir("${SERVICE_DIR}") {

                    sh '''
                        set -euo pipefail

                        echo "======================================="
                        echo "PLATFORM CONTRACT VALIDATION"
                        echo "======================================="

                        mvn -Dtest=PlatformContractTest test

                        echo "Platform runtime contract validated successfully."
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {

            agent {

                docker {

                    image 'maven:3.9-eclipse-temurin-21'

                    args '--network devops-network -v $HOME/.m2:/root/.m2'

                    reuseNode true
                }
            }

            steps {

                withSonarQubeEnv("${SONARQUBE_ENV}") {

                    dir("${SERVICE_DIR}") {

                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                                -Dsonar.projectKey=auth-service \
                                -Dsonar.projectName=auth-service
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {

            steps {

                timeout(
                    time: 5,
                    unit: 'MINUTES'
                ) {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }

        stage('OWASP Dependency Check') {

            when {

                expression {

                    return params.RUN_OWASP_SCAN
                }
            }

            options {

                timeout(
                    time: 15,
                    unit: 'MINUTES'
                )
            }

            steps {

                withCredentials([
                    string(
                        credentialsId: 'nvd-api-key',
                        variable: 'NVD_API_KEY'
                    )
                ]) {

                    catchError(
                        buildResult: 'SUCCESS',
                        stageResult: 'UNSTABLE'
                    ) {

                        sh '''

                            echo "======================================="
                            echo "OWASP DEPENDENCY CHECK"
                            echo "======================================="

                            echo ""
                            echo "Workspace"

                            echo "$WORKSPACE"

                            pwd

                            mkdir -p reports

                            echo ""
                            echo "Dependency Check Cache"

                            ls -lah /data/jenkins/dependency-check-data || true

                            echo ""

                            echo "Cache Size"

                            du -sh /data/jenkins/dependency-check-data || true

                            echo ""

                            echo "Running Dependency Check..."

                            docker run --rm \
                              -v "$WORKSPACE":/src \
                              -v /data/jenkins/dependency-check-data:/usr/share/dependency-check/data \
                              owasp/dependency-check:12.1.8 \
                              --nvdApiKey "${NVD_API_KEY}" \
                              --scan /src \
                              --format HTML \
                              --out /src/reports

                            echo ""

                            echo "Generated Reports"

                            ls -lah reports || true

                        '''
                    }
                }
            }

            post {

                always {

                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'reports',
                        reportFiles: 'dependency-check-report.html',
                        reportName: 'OWASP Dependency Check Report'
                    ])
                }
            }
        }

        stage('Trivy Filesystem Scan') {

            steps {

                sh '''

                    docker run --rm \
                      -v "$WORKSPACE":/workspace \
                      -v /data/jenkins/trivy-cache:/root/.cache/trivy \
                      aquasec/trivy:0.65.0 \
                      fs \
                      --severity HIGH,CRITICAL \
                      /workspace

                '''
            }
        }

        stage('Build Docker Image') {

            steps {

                dir("${SERVICE_DIR}") {

                    sh '''

                        docker build \
                          -t ${IMAGE_NAME}:${IMAGE_TAG} .

                    '''
                }
            }
        }

        stage('Trivy Container Scan') {

            steps {

                sh '''

                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      -v /data/jenkins/trivy-cache:/root/.cache/trivy \
                      aquasec/trivy:0.65.0 \
                      image \
                      --severity HIGH,CRITICAL \
                      --exit-code 0 \
                      ${IMAGE_NAME}:${IMAGE_TAG}

                '''
            }
        }

        stage('Login To ECR') {

            steps {

                sh '''

                    aws ecr get-login-password \
                      --region ${AWS_REGION} \
                    | docker login \
                      --username AWS \
                      --password-stdin \
                      ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                '''
            }
        }

        stage('Push Image To ECR') {

            steps {

                sh '''

                    docker tag \
                      ${IMAGE_NAME}:${IMAGE_TAG} \
                      ${ECR_REPO}:${IMAGE_TAG}

                    docker push \
                      ${ECR_REPO}:${IMAGE_TAG}

                '''
            }
        }

        stage('Resolve Platform Environment') {

            steps {

                sshagent(['github-ssh']) {

                    sh '''

                        set -euo pipefail

                        echo "======================================="
                        echo "RESOLVE PLATFORM ENVIRONMENT"
                        echo "======================================="

                        rm -rf platform-environment-gitops

                        git clone \
                            --depth 1 \
                            "${GITOPS_REPO}" \
                            platform-environment-gitops

                        PLATFORM_ENV_FILE="platform-environment-gitops/platform/environments/${PLATFORM_ENVIRONMENT}.yaml"

                        if [ ! -f "${PLATFORM_ENV_FILE}" ]; then
                            echo "ERROR: Platform environment configuration not found:"
                            echo "${PLATFORM_ENV_FILE}"
                            exit 1
                        fi

                        echo "Platform environment configuration:"
                        cat "${PLATFORM_ENV_FILE}"

                        export ARTIFACT_BUCKET=$(yq e -r '.artifactStore.bucket' "${PLATFORM_ENV_FILE}")

                        if [ -z "${ARTIFACT_BUCKET}" ]; then
                            echo "ERROR: artifactStore.bucket is missing."
                            exit 1
                        fi

                        echo "Platform environment : ${PLATFORM_ENVIRONMENT}"
                        echo "Artifact bucket      : ${ARTIFACT_BUCKET}"

                        echo "${ARTIFACT_BUCKET}" > "${WORKSPACE}/.artifact_bucket"

                        echo "Platform environment resolved successfully."

                    '''
                }
            }
        }

        stage('Package & Upload Migration Artifact') {

            steps {

                dir("${SERVICE_DIR}") {

                    sh '''
                        set -euo pipefail

                        ARTIFACT_BUCKET=$(cat "${WORKSPACE}/.artifact_bucket")

                        MIGRATION_PATH="${IMAGE_NAME}/migrations/${GIT_COMMIT}"

                        MIGRATION_S3_URI="s3://${ARTIFACT_BUCKET}/${MIGRATION_PATH}/db/migration"

                        MIGRATION_DIR="src/main/resources/db/migration"

                        echo "Migration files:"
                        find "${MIGRATION_DIR}" -type f -name "*.sql" | sort

                        if ! find "${MIGRATION_DIR}" -type f -name "*.sql" | grep -q .; then
                            echo "ERROR: No migration SQL files found"
                            exit 1
                        fi

                        echo "Uploading migrations to:"
                        echo "${MIGRATION_S3_URI}"

                        aws s3 sync \
                            "${MIGRATION_DIR}/" \
                            "${MIGRATION_S3_URI}/" \
                            --exclude "*" \
                            --include "*.sql"

                        echo "Migration artifact uploaded successfully."

                        aws s3 ls "${MIGRATION_S3_URI}/"
                    '''
                }
            }
        }

        stage('Update GitOps Repository') {

            steps {

                sshagent(['github-ssh']) {

                    sh '''

                        set -euo pipefail

                        echo "======================================="
                        echo "CONFIGURE TEMP DIRECTORY"
                        echo "======================================="

                        export TMPDIR="$HOME/yq-tmp"

                        mkdir -p "$TMPDIR"

                        chmod 700 "$TMPDIR"

                        echo "TMPDIR=$TMPDIR"

                        ls -ld "$TMPDIR"


                        echo "======================================="
                        echo "CLONE GITOPS REPOSITORY"
                        echo "======================================="

                        rm -rf enterprise-platform-gitops

                        git clone "${GITOPS_REPO}"

                        cd enterprise-platform-gitops


                        echo "======================================="
                        echo "READ PLATFORM SERVICE CONTRACT"
                        echo "======================================="

                        CONTRACT_FILE="${TMPDIR}/gitops-service-contract.json"

                        ARTIFACT_BUCKET=$(cat "${WORKSPACE}/.artifact_bucket")

                        aws s3 cp \
                            "s3://${ARTIFACT_BUCKET}/platform-contract/${PLATFORM_ENVIRONMENT}/gitops-service-contract.json" \
                            "${CONTRACT_FILE}"

                        echo "Validating platform service contract..."

                        jq empty "${CONTRACT_FILE}"

                        SERVICE_CONTRACT=$(jq -e '."auth-service"' "${CONTRACT_FILE}")

                        echo "Auth-service contract resolved successfully."


                        echo "======================================="
                        echo "RESOLVE PLATFORM CONTRACT"
                        echo "======================================="

                        export SERVICE_NAMESPACE=$(echo "${SERVICE_CONTRACT}" | jq -r '.namespace // empty')
                        export DB_ENABLED=$(echo "${SERVICE_CONTRACT}" | jq -r '.database.enabled // false')
                        export DB_ENGINE=$(echo "${SERVICE_CONTRACT}" | jq -r '.database.engine // empty')
                        export DB_HOST=$(echo "${SERVICE_CONTRACT}" | jq -r '.database.host // empty')
                        export DB_PORT=$(echo "${SERVICE_CONTRACT}" | jq -r '.database.port // empty')
                        export DB_NAME=$(echo "${SERVICE_CONTRACT}" | jq -r '.database.name // empty')
                        export DB_CREDENTIAL_REFERENCE=$(echo "${SERVICE_CONTRACT}" | jq -r '.database.credential_reference // empty')

                        export DB_SERVICE_ACCOUNT=$(echo "${SERVICE_CONTRACT}" | jq -r '.workload_identity.service_account_name // empty')
                        export DB_ROLE_ARN=$(echo "${SERVICE_CONTRACT}" | jq -r '.workload_identity.role_arn // empty')

                        export APPLICATION_SG_ID=$(echo "${SERVICE_CONTRACT}" | jq -r '.security_group.id // empty')

                        export MIGRATION_ENABLED=$(echo "${SERVICE_CONTRACT}" | jq -r '.migration.enabled // false')
                        export MIGRATION_ENGINE=$(echo "${SERVICE_CONTRACT}" | jq -r '.migration.engine // empty')
                        export MIGRATION_SERVICE_ACCOUNT=$(echo "${SERVICE_CONTRACT}" | jq -r '.migration.service_account_name // empty')
                        export MIGRATION_ROLE_ARN=$(echo "${SERVICE_CONTRACT}" | jq -r '.migration.role_arn // empty')
                        export MIGRATION_BUCKET=$(echo "${SERVICE_CONTRACT}" | jq -r '.migration.artifact.bucket // empty')


                        echo "Namespace              : ${SERVICE_NAMESPACE}"
                        echo "Database enabled       : ${DB_ENABLED}"
                        echo "Database engine        : ${DB_ENGINE}"
                        echo "Database host          : ${DB_HOST}"
                        echo "Database port          : ${DB_PORT}"
                        echo "Database name          : ${DB_NAME}"
                        echo "Database credential    : configured"
                        echo "Database service acct  : ${DB_SERVICE_ACCOUNT}"
                        echo "Database IAM role      : ${DB_ROLE_ARN}"
                        echo "Application SG         : ${APPLICATION_SG_ID}"
                        echo "Migration enabled      : ${MIGRATION_ENABLED}"
                        echo "Migration engine       : ${MIGRATION_ENGINE}"
                        echo "Migration service acct : ${MIGRATION_SERVICE_ACCOUNT}"
                        echo "Migration IAM role     : ${MIGRATION_ROLE_ARN}"
                        echo "Migration bucket       : ${MIGRATION_BUCKET}"


                        echo "======================================="
                        echo "VALIDATE PLATFORM CONTRACT"
                        echo "======================================="

                        if [ -z "${SERVICE_NAMESPACE}" ]; then
                            echo "ERROR: Service namespace is missing from platform contract."
                            exit 1
                        fi

                        if [ "${DB_ENABLED}" = "true" ]; then

                            if [ -z "${DB_HOST}" ] || \
                               [ -z "${DB_PORT}" ] || \
                               [ -z "${DB_NAME}" ] || \
                               [ -z "${DB_CREDENTIAL_REFERENCE}" ]; then

                                echo "ERROR: Database contract is incomplete."
                                exit 1

                            fi

                            if [ -z "${DB_ROLE_ARN}" ] || \
                               [ -z "${DB_SERVICE_ACCOUNT}" ]; then

                                echo "ERROR: Database workload identity contract is incomplete."
                                exit 1

                            fi

                        fi


                        if [ "${MIGRATION_ENABLED}" = "true" ]; then

                            if [ -z "${MIGRATION_ENGINE}" ] || \
                               [ -z "${MIGRATION_SERVICE_ACCOUNT}" ] || \
                               [ -z "${MIGRATION_ROLE_ARN}" ] || \
                               [ -z "${MIGRATION_BUCKET}" ]; then

                                echo "ERROR: Migration contract is incomplete."
                                exit 1

                            fi

                        fi


                        echo "Platform contract validation passed."


                        echo "======================================="
                        echo "UPDATE AUTH-SERVICE GITOPS VALUES"
                        echo "======================================="

                        VALUES_FILE="charts/auth-service/values-dev.yaml"


                        yq e -i \
                            '.image.tag = env(IMAGE_TAG)' \
                            "${VALUES_FILE}"


                        yq e -i \
                            '.serviceAccount.create = true |
                             .serviceAccount.name = env(DB_SERVICE_ACCOUNT) |
                             .serviceAccount.annotations."eks.amazonaws.com/role-arn" = env(DB_ROLE_ARN)' \
                            "${VALUES_FILE}"


                        yq e -i \
                            '.database.enabled = env(DB_ENABLED) |
                             .database.host = env(DB_HOST) |
                             .database.port = env(DB_PORT) |
                             .database.name = env(DB_NAME) |
                             .database.credentialReference = env(DB_CREDENTIAL_REFERENCE)' \
                            "${VALUES_FILE}"


                        yq e -i \
                            '.securityGroupPolicy.enabled = true |
                             .securityGroupPolicy.groupId = env(APPLICATION_SG_ID)' \
                            "${VALUES_FILE}"


                        if [ "${MIGRATION_ENABLED}" = "true" ]; then

                            export MIGRATION_KEY="${IMAGE_NAME}/migrations/${GIT_COMMIT}/db/migration"

                            yq e -i \
                                '.migration.enabled = true |
                                 .migration.engine = env(MIGRATION_ENGINE) |
                                 .migration.artifact.bucket = env(MIGRATION_BUCKET) |
                                 .migration.artifact.key = env(MIGRATION_KEY) |
                                 .migration.serviceAccount.name = env(MIGRATION_SERVICE_ACCOUNT) |
                                 .migration.serviceAccount.roleArn = env(MIGRATION_ROLE_ARN) |
                                 .migration.securityGroupPolicy.enabled = true |
                                 .migration.securityGroupPolicy.groupId = env(APPLICATION_SG_ID)' \
                                "${VALUES_FILE}"

                        else

                            yq e -i \
                                '.migration.enabled = false' \
                                "${VALUES_FILE}"

                        fi


                        echo "======================================="
                        echo "VERIFY GITOPS VALUES"
                        echo "======================================="

                        echo "Image:"
                        yq e '.image' "${VALUES_FILE}"

                        echo "Database:"
                        yq e '.database' "${VALUES_FILE}"

                        echo "Service Account:"
                        yq e '.serviceAccount' "${VALUES_FILE}"

                        echo "Security Group Policy:"
                        yq e '.securityGroupPolicy' "${VALUES_FILE}"

                        echo "Migration:"
                        yq e '.migration' "${VALUES_FILE}"


                        echo "======================================="
                        echo "COMMIT GITOPS CHANGE"
                        echo "======================================="

                        git config user.email "jenkins@platform.local"

                        git config user.name "Jenkins"

                        git add "${VALUES_FILE}"

                        if git diff --cached --quiet; then

                            echo "No GitOps changes detected."

                        else

                            git commit \
                                -m "Deploy ${IMAGE_NAME} ${IMAGE_TAG} with platform contract"

                            git push origin main

                        fi

                    '''
                }
            }
        }
    }

    post {

        success {

            echo "Build completed successfully."

            sh '''
                docker image prune -f || true
            '''
        }

        failure {

            echo "Build failed."
        }

        always {

            archiveArtifacts(
                artifacts: 'reports/**/*.*',
                allowEmptyArchive: true
            )

            cleanWs()
        }
    }
}

pipeline {

    agent any

    parameters {

        booleanParam(
            name: 'RUN_OWASP_SCAN',
            defaultValue: false,
            description: 'Run OWASP Dependency Check scan'
        )

        string(
            name: 'PLATFORM_ENVIRONMENT',
            defaultValue: 'dev',
            description: 'Platform environment to deploy to'
        )
    }

    environment {

        AWS_REGION = "us-east-1"

        ACCOUNT_ID = "761018849945"

        IMAGE_NAME = "auth-service"

        IMAGE_TAG = "${BUILD_NUMBER}"

        ECR_REPO = "${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/${IMAGE_NAME}"

        MIGRATION_PATH = "${IMAGE_NAME}/migrations/${GIT_COMMIT}"

        GITOPS_REPO = "git@github.com:Oluwole-Faluwoye/enterprise-platform-gitops.git"

        SONARQUBE_ENV = "sonarqube"

        SERVICE_DIR = "services/auth-service"
    }

    options {

        timestamps()

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20'
            )
        )

        ansiColor('xterm')
    }

    stages {

        stage('Checkout') {

            steps {

                echo "Checking out source code..."

                checkout scm

                echo "Git commit: ${GIT_COMMIT}"
            }
        }

        stage('Build & Unit Tests') {

            agent {

                docker {

                    image 'maven:3.9-eclipse-temurin-21'

                    args '--network devops-network -v $HOME/.m2:/root/.m2'

                    reuseNode true
                }
            }

            steps {

                dir("${SERVICE_DIR}") {

                    sh '''
                        mvn clean verify
                    '''
                }
            }

            post {

                always {

                    junit(
                        testResults: 'services/auth-service/target/surefire-reports/*.xml',
                        allowEmptyResults: true
                    )
                }
            }
        }

        stage('Platform Contract Validation') {

            agent {

                docker {

                    image 'maven:3.9-eclipse-temurin-21'

                    args '--network devops-network -v $HOME/.m2:/root/.m2'

                    reuseNode true
                }
            }

            steps {

                dir("${SERVICE_DIR}") {

                    sh '''
                        set -euo pipefail

                        echo "======================================="
                        echo "PLATFORM CONTRACT VALIDATION"
                        echo "======================================="

                        mvn -Dtest=PlatformContractTest test

                        echo "Platform runtime contract validated successfully."
                    '''
                }
            }
        }

        stage('SonarQube Analysis') {

            agent {

                docker {

                    image 'maven:3.9-eclipse-temurin-21'

                    args '--network devops-network -v $HOME/.m2:/root/.m2'

                    reuseNode true
                }
            }

            steps {

                withSonarQubeEnv("${SONARQUBE_ENV}") {

                    dir("${SERVICE_DIR}") {

                        sh '''
                            mvn org.sonarsource.scanner.maven:sonar-maven-plugin:sonar \
                                -Dsonar.projectKey=auth-service \
                                -Dsonar.projectName=auth-service
                        '''
                    }
                }
            }
        }

        stage('Quality Gate') {

            steps {

                timeout(
                    time: 5,
                    unit: 'MINUTES'
                ) {

                    waitForQualityGate(
                        abortPipeline: true
                    )
                }
            }
        }

        stage('OWASP Dependency Check') {

            when {

                expression {

                    return params.RUN_OWASP_SCAN
                }
            }

            options {

                timeout(
                    time: 15,
                    unit: 'MINUTES'
                )
            }

            steps {

                withCredentials([
                    string(
                        credentialsId: 'nvd-api-key',
                        variable: 'NVD_API_KEY'
                    )
                ]) {

                    catchError(
                        buildResult: 'SUCCESS',
                        stageResult: 'UNSTABLE'
                    ) {

                        sh '''

                            echo "======================================="
                            echo "OWASP DEPENDENCY CHECK"
                            echo "======================================="

                            echo ""
                            echo "Workspace"

                            echo "$WORKSPACE"

                            pwd

                            mkdir -p reports

                            echo ""
                            echo "Dependency Check Cache"

                            ls -lah /data/jenkins/dependency-check-data || true

                            echo ""

                            echo "Cache Size"

                            du -sh /data/jenkins/dependency-check-data || true

                            echo ""

                            echo "Running Dependency Check..."

                            docker run --rm \
                              -v "$WORKSPACE":/src \
                              -v /data/jenkins/dependency-check-data:/usr/share/dependency-check/data \
                              owasp/dependency-check:12.1.8 \
                              --nvdApiKey "${NVD_API_KEY}" \
                              --scan /src \
                              --format HTML \
                              --out /src/reports

                            echo ""

                            echo "Generated Reports"

                            ls -lah reports || true

                        '''
                    }
                }
            }

            post {

                always {

                    publishHTML([
                        allowMissing: true,
                        alwaysLinkToLastBuild: true,
                        keepAll: true,
                        reportDir: 'reports',
                        reportFiles: 'dependency-check-report.html',
                        reportName: 'OWASP Dependency Check Report'
                    ])
                }
            }
        }

        stage('Trivy Filesystem Scan') {

            steps {

                sh '''

                    docker run --rm \
                      -v "$WORKSPACE":/workspace \
                      -v /data/jenkins/trivy-cache:/root/.cache/trivy \
                      aquasec/trivy:0.65.0 \
                      fs \
                      --severity HIGH,CRITICAL \
                      /workspace

                '''
            }
        }

        stage('Build Docker Image') {

            steps {

                dir("${SERVICE_DIR}") {

                    sh '''

                        docker build \
                          -t ${IMAGE_NAME}:${IMAGE_TAG} .

                    '''
                }
            }
        }

        stage('Trivy Container Scan') {

            steps {

                sh '''

                    docker run --rm \
                      -v /var/run/docker.sock:/var/run/docker.sock \
                      -v /data/jenkins/trivy-cache:/root/.cache/trivy \
                      aquasec/trivy:0.65.0 \
                      image \
                      --severity HIGH,CRITICAL \
                      --exit-code 0 \
                      ${IMAGE_NAME}:${IMAGE_TAG}

                '''
            }
        }

        stage('Login To ECR') {

            steps {

                sh '''

                    aws ecr get-login-password \
                      --region ${AWS_REGION} \
                    | docker login \
                      --username AWS \
                      --password-stdin \
                      ${ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com

                '''
            }
        }

        stage('Push Image To ECR') {

            steps {

                sh '''

                    docker tag \
                      ${IMAGE_NAME}:${IMAGE_TAG} \
                      ${ECR_REPO}:${IMAGE_TAG}

                    docker push \
                      ${ECR_REPO}:${IMAGE_TAG}

                '''
            }
        }

        stage('Resolve Platform Environment') {

            steps {

                sshagent(['github-ssh']) {

                    sh '''

                        set -euo pipefail

                        echo "======================================="
                        echo "RESOLVE PLATFORM ENVIRONMENT"
                        echo "======================================="

                        rm -rf platform-environment-gitops

                        git clone \
                            --depth 1 \
                            "${GITOPS_REPO}" \
                            platform-environment-gitops

                        PLATFORM_ENV_FILE="platform-environment-gitops/platform/environments/${PLATFORM_ENVIRONMENT}.yaml"

                        if [ ! -f "${PLATFORM_ENV_FILE}" ]; then
                            echo "ERROR: Platform environment configuration not found:"
                            echo "${PLATFORM_ENV_FILE}"
                            exit 1
                        fi

                        echo "Platform environment configuration:"
                        cat "${PLATFORM_ENV_FILE}"

                        export ARTIFACT_BUCKET=$(yq e -r '.artifactStore.bucket' "${PLATFORM_ENV_FILE}")

                        if [ -z "${ARTIFACT_BUCKET}" ]; then
                            echo "ERROR: artifactStore.bucket is missing."
                            exit 1
                        fi

                        echo "Platform environment : ${PLATFORM_ENVIRONMENT}"
                        echo "Artifact bucket      : ${ARTIFACT_BUCKET}"

                        echo "${ARTIFACT_BUCKET}" > "${WORKSPACE}/.artifact_bucket"

                        echo "Platform environment resolved successfully."

                    '''
                }
            }
        }

        stage('Package & Upload Migration Artifact') {

            steps {

                dir("${SERVICE_DIR}") {

                    sh '''
                        set -euo pipefail

                        ARTIFACT_BUCKET=$(cat "${WORKSPACE}/.artifact_bucket")

                        MIGRATION_PATH="${IMAGE_NAME}/migrations/${GIT_COMMIT}"

                        MIGRATION_S3_URI="s3://${ARTIFACT_BUCKET}/${MIGRATION_PATH}/db/migration"

                        MIGRATION_DIR="src/main/resources/db/migration"

                        echo "Migration files:"
                        find "${MIGRATION_DIR}" -type f -name "*.sql" | sort

                        if ! find "${MIGRATION_DIR}" -type f -name "*.sql" | grep -q .; then
                            echo "ERROR: No migration SQL files found"
                            exit 1
                        fi

                        echo "Uploading migrations to:"
                        echo "${MIGRATION_S3_URI}"

                        aws s3 sync \
                            "${MIGRATION_DIR}/" \
                            "${MIGRATION_S3_URI}/" \
                            --exclude "*" \
                            --include "*.sql"

                        echo "Migration artifact uploaded successfully."

                        aws s3 ls "${MIGRATION_S3_URI}/"
                    '''
                }
            }
        }


        stage('Update GitOps Repository') {
            steps {
                sshagent(['github-ssh']) {
                    sh '''
                        set -euo pipefail

                        echo "======================================="
                        echo "RECONCILE GITOPS USING PLATFORM CLI"
                        echo "======================================="

                        export TMPDIR="$HOME/yq-tmp"
                        mkdir -p "$TMPDIR"
                        chmod 700 "$TMPDIR"

                        PLATFORM_CLI="${WORKSPACE}/platform-ci/bin/platform"

                        if [ ! -x "$PLATFORM_CLI" ]; then
                            echo "ERROR: Shared platform CLI not found: $PLATFORM_CLI" >&2
                            exit 1
                        fi

                        ARTIFACT_BUCKET="$(cat "${WORKSPACE}/.artifact_bucket")"
                        GITOPS_TMP_ROOT="$(mktemp -d "${TMPDIR}/gitops-reconcile.XXXXXX")"
                        trap 'rm -rf "$GITOPS_TMP_ROOT"' EXIT

                        CONTRACT_FILE="${GITOPS_TMP_ROOT}/gitops-service-contract.json"
                        GITOPS_WORKTREE="${GITOPS_TMP_ROOT}/repo"

                        echo "Downloading resolved service contract..."

                        aws s3 cp \
                            "s3://${ARTIFACT_BUCKET}/platform-contract/${PLATFORM_ENVIRONMENT}/gitops-service-contract.json" \
                            "$CONTRACT_FILE"

                        jq empty "$CONTRACT_FILE"
                        jq -e '."auth-service"' "$CONTRACT_FILE" >/dev/null

                        MIGRATION_ENABLED="$(jq -r \
                            '."auth-service".migration.enabled // false' \
                            "$CONTRACT_FILE")"

                        MIGRATION_KEY="${IMAGE_NAME}/migrations/${GIT_COMMIT}/db/migration"

                        echo "Cloning GitOps into temporary workspace..."
                        git clone "${GITOPS_REPO}" "$GITOPS_WORKTREE"

                        echo "Running shared platform reconciliation in DRY-RUN mode."
                        echo "Image tag: ${IMAGE_TAG}"
                        echo "Migration enabled: ${MIGRATION_ENABLED}"

                        if [ "$MIGRATION_ENABLED" = "true" ]; then
                            "$PLATFORM_CLI" reconcile-gitops \
                                "$CONTRACT_FILE" \
                                "$GITOPS_WORKTREE" \
                                --dry-run \
                                --image-tag "$IMAGE_TAG" \
                                --image-repository "$ECR_REPO" \
                                --migration-artifact-key "$MIGRATION_KEY"
                        else
                            "$PLATFORM_CLI" reconcile-gitops \
                                "$CONTRACT_FILE" \
                                "$GITOPS_WORKTREE" \
                                --dry-run \
                                --image-tag "$IMAGE_TAG" \
                                --image-repository "$ECR_REPO"
                        fi

                        echo "======================================="
                        echo "VERIFY NO GITOPS FILES WERE CHANGED"
                        echo "======================================="

                        if [ -n "$(git -C "$GITOPS_WORKTREE" status --porcelain)" ]; then
                            echo "ERROR: GitOps working tree changed during dry-run." >&2
                            git -C "$GITOPS_WORKTREE" status --short
                            exit 1
                        fi

                        echo "GitOps working tree remains clean."
                        echo "DRY-RUN STAGE COMPLETE. Nothing committed or pushed."
                    '''
                }
            }
        }
    }

    post {

        success {

            echo "Build completed successfully."

            sh '''
                docker image prune -f || true
            '''
        }

        failure {

            echo "Build failed."
        }

        always {

            archiveArtifacts(
                artifacts: 'reports/**/*.*',
                allowEmptyArchive: true
            )

            cleanWs()
        }
    }
}

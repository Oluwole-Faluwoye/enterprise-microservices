pipeline {

    agent any

    parameters {

        string(
            name: 'SERVICE_DIR',
            defaultValue: 'services/auth-service',
            description: 'Service directory used for runtime validation and Docker build'
        )

        string(
            name: 'PLATFORM_ENVIRONMENT',
            defaultValue: 'dev',
            description: 'Platform environment'
        )
    }

    environment {

        AWS_REGION = "us-east-1"

        GITOPS_REPO = "git@github.com:Oluwole-Faluwoye/enterprise-platform-gitops.git"

        PLATFORM_ENV = "${params.PLATFORM_ENVIRONMENT}"

        SONARQUBE_ENV = "sonarqube"

        SERVICE_DIR = "${params.SERVICE_DIR}"
    }

    options {

        timestamps()

        disableConcurrentBuilds()

        buildDiscarder(
            logRotator(
                numToKeepStr: '20'
            )
        )

        ansiColor('xterm')
    }

    stages {

        stage('Checkout') {

            steps {

                echo "Checking out source code..."

                checkout scm

                echo "Git commit: ${GIT_COMMIT}"
            }
        }


        stage('Validate Service Contract') {

            steps {

                script {

                    def manifest = "${params.SERVICE_DIR}/platform.yaml"

                    if (!fileExists(manifest)) {
                        error("Missing platform.yaml: ${manifest}")
                    }

                    sh """
                        set -euo pipefail

                        ./platform-ci/bin/platform validate '${params.SERVICE_DIR}'
                    """

                    env.SERVICE_RUNTIME = sh(
                        script: "yq e -r '.runtime.type' '${manifest}'",
                        returnStdout: true
                    ).trim()
                }
            }
        }


        stage('Build & Unit Tests') {

            steps {

                script {

                    if (env.SERVICE_RUNTIME == 'nodejs') {

                        docker.image('node:22-alpine').inside {

                            dir("${params.SERVICE_DIR}") {

                                sh '''
                                    set -euo pipefail

                                    npm ci
                                    npm test --if-present
                                '''
                            }
                        }

                    } else if (env.SERVICE_RUNTIME == 'spring-boot') {

                        docker.image(
                            'maven:3.9-eclipse-temurin-21'
                        ).inside {

                            dir("${params.SERVICE_DIR}") {

                                sh '''
                                    set -euo pipefail

                                    mvn clean verify
                                '''
                            }
                        }

                    } else {

                        error(
                            "Unsupported runtime: ${env.SERVICE_RUNTIME}"
                        )
                    }
                }
            }
        }


        stage('Platform Contract Validation') {

            steps {

                sh '''
                    set -euo pipefail

                    chmod +x platform-ci/bin/platform
                    chmod +x platform-ci/lib/*.sh

                    ./platform-ci/bin/platform test-runtime "${SERVICE_DIR}"
                '''
            }
        }


        stage('Resolve Platform Environment') {

            steps {

                sshagent(['github-ssh']) {

                    sh '''
                        set -euo pipefail

                        echo "======================================="
                        echo "RESOLVE PLATFORM ENVIRONMENT"
                        echo "======================================="

                        rm -rf platform-environment-gitops

                        git clone \
                            --depth 1 \
                            "${GITOPS_REPO}" \
                            platform-environment-gitops

                        PLATFORM_ENV_FILE="platform-environment-gitops/platform/environments/${PLATFORM_ENV}.yaml"

                        if [ ! -f "${PLATFORM_ENV_FILE}" ]; then

                            echo "ERROR: Platform environment configuration not found:"
                            echo "${PLATFORM_ENV_FILE}"

                            exit 1

                        fi

                        echo ""
                        echo "Platform environment configuration:"
                        cat "${PLATFORM_ENV_FILE}"

                        ARTIFACT_BUCKET=$(
                            yq e -r \
                                '.artifactStore.bucket // ""' \
                                "${PLATFORM_ENV_FILE}"
                        )

                        if [ -z "${ARTIFACT_BUCKET}" ] ||
                           [ "${ARTIFACT_BUCKET}" = "null" ]; then

                            echo "ERROR: artifactStore.bucket is missing."

                            exit 1

                        fi

                        echo ""
                        echo "Platform environment : ${PLATFORM_ENV}"
                        echo "Artifact bucket      : ${ARTIFACT_BUCKET}"

                        echo "${ARTIFACT_BUCKET}" \
                            > "${WORKSPACE}/.platform_artifact_bucket"

                        echo ""
                        echo "Platform environment resolved successfully."
                    '''
                }
            }
        }


        stage('Generate Platform Contract') {

            steps {

                sh '''
                    set -euo pipefail

                    echo "======================================="
                    echo "GENERATE PLATFORM CONTRACT"
                    echo "======================================="

                    chmod +x platform-ci/bin/platform
                    chmod +x platform-ci/lib/*.sh

                    ./platform-ci/bin/platform generate-contract

                    echo ""
                    echo "Generated platform contract:"
                    cat platform-contract.json

                    echo ""
                    echo "Platform contract generated successfully."
                '''
            }
        }


        stage('Publish Platform Contract') {

            steps {

                sh '''
                    set -euo pipefail

                    echo "======================================="
                    echo "PUBLISH PLATFORM CONTRACT"
                    echo "======================================="

                    ARTIFACT_BUCKET=$(
                        cat "${WORKSPACE}/.platform_artifact_bucket"
                    )

                    if [ -z "${ARTIFACT_BUCKET}" ]; then

                        echo "ERROR: Artifact bucket could not be resolved."

                        exit 1

                    fi

                    export PLATFORM_ARTIFACT_BUCKET="${ARTIFACT_BUCKET}"

                    export PLATFORM_CONTRACT_KEY="platform-contract/${PLATFORM_ENV}/service-contract.json"

                    echo "Platform environment : ${PLATFORM_ENV}"
                    echo "Artifact bucket      : ${PLATFORM_ARTIFACT_BUCKET}"
                    echo "Contract key         : ${PLATFORM_CONTRACT_KEY}"

                    ./platform-ci/bin/platform publish-contract

                    echo ""
                    echo "Platform contract published successfully."
                '''
            }
        }


        stage('Build Docker Image') {

            steps {

                script {

                    dir("${params.SERVICE_DIR}") {

                        sh '''
                            set -euo pipefail

                            echo "Building Docker image..."

                            docker build \
                                -t "${JOB_NAME}:${BUILD_NUMBER}" \
                                .

                            echo "Docker image built successfully."
                        '''
                    }
                }
            }
        }
    }


    post {

        success {

            echo "Platform CI pipeline completed successfully."
        }

        failure {

            echo "Platform CI pipeline failed."
        }

        always {

            sh '''
                rm -rf platform-environment-gitops
                rm -f .platform_artifact_bucket
            '''

            cleanWs()
        }
    }
}

pipeline {

    agent any

    parameters {

        string(
            name: 'SERVICE_DIR',
            defaultValue: 'services/auth-service',
            description: 'Service directory used for runtime validation and Docker build'
        )

        string(
            name: 'PLATFORM_ENVIRONMENT',
            defaultValue: 'dev',
            description: 'Platform environment'
        )
    }

    environment {

        AWS_REGION = "us-east-1"

        GITOPS_REPO =
            "git@github.com:Oluwole-Faluwoye/enterprise-platform-gitops.git"

        PLATFORM_ENV = "${params.PLATFORM_ENVIRONMENT}"

        SONARQUBE_ENV = "sonarqube"

        SERVICE_DIR = "${params.SERVICE_DIR}"
    }

    stages {

        stage('Checkout') {

            steps {

                echo "Checking out source code..."

                checkout scm

                script {
                    def gitCommit = sh(
                        script: 'git rev-parse HEAD',
                        returnStdout: true
                    ).trim()

                    echo "Git commit: ${gitCommit}"
                }
            }
        }


        stage('Validate Service Contract') {

            steps {

                script {

                    if (!fileExists("${params.SERVICE_DIR}/platform.yaml")) {

                        error(
                            "Missing service contract: " +
                            "${params.SERVICE_DIR}/platform.yaml"
                        )
                    }

                    sh """
                        set -euo pipefail

                        ./platform-ci/bin/platform \
                            validate ${params.SERVICE_DIR}
                    """

                    env.SERVICE_RUNTIME = sh(
                        script: """
                            yq e -r \
                            '.runtime.type' \
                            '${params.SERVICE_DIR}/platform.yaml'
                        """,
                        returnStdout: true
                    ).trim()
                }
            }
        }


        stage('Build & Unit Tests') {

            steps {

                script {

                    if (env.SERVICE_RUNTIME == 'nodejs') {

                        docker.image(
                            'node:22-alpine'
                        ).inside {

                            dir("${params.SERVICE_DIR}") {

                                sh '''
                                    set -euo pipefail

                                    npm ci
                                    npm test --if-present
                                '''
                            }
                        }

                    } else if (env.SERVICE_RUNTIME == 'spring-boot') {

                        docker.image(
                            'maven:3.9-eclipse-temurin-21'
                        ).inside("--entrypoint=''") {

                            dir("${params.SERVICE_DIR}") {

                                sh '''
                                    set -euo pipefail

                                    mvn clean verify
                                '''
                            }
                        }

                    } else {

                        error(
                            "Unsupported runtime: " +
                            "${env.SERVICE_RUNTIME}"
                        )
                    }
                }
            }
        }


        stage('Platform Contract Validation') {

            steps {

                sh '''
                    set -euo pipefail

                    chmod +x platform-ci/bin/platform
                    chmod +x platform-ci/lib/*.sh

                    ./platform-ci/bin/platform \
                        test-runtime \
                        "${SERVICE_DIR}"
                '''
            }
        }


        stage('Resolve Platform Environment') {

            steps {

                sshagent(['github-ssh']) {

                    sh '''
                        set -euo pipefail

                        rm -rf platform-environment-gitops

                        git clone \
                            --depth 1 \
                            "${GITOPS_REPO}" \
                            platform-environment-gitops

                        PLATFORM_ENV_FILE="platform-environment-gitops/platform/environments/${PLATFORM_ENV}.yaml"

                        if [ ! -f "${PLATFORM_ENV_FILE}" ]; then

                            echo "ERROR: Platform environment file not found:"
                            echo "${PLATFORM_ENV_FILE}"

                            exit 1
                        fi

                        ARTIFACT_BUCKET=$(
                            yq e -r \
                            '.artifactStore.bucket // ""' \
                            "${PLATFORM_ENV_FILE}"
                        )

                        if [ -z "${ARTIFACT_BUCKET}" ] ||
                           [ "${ARTIFACT_BUCKET}" = "null" ]; then

                            echo "ERROR: artifactStore.bucket is missing."

                            exit 1
                        fi

                        echo "${ARTIFACT_BUCKET}" \
                            > "${WORKSPACE}/.platform_artifact_bucket"

                        echo ""
                        echo "Platform environment:"
                        echo "${PLATFORM_ENV}"

                        echo ""
                        echo "Platform artifact bucket:"
                        echo "${ARTIFACT_BUCKET}"
                    '''
                }
            }
        }


        stage('Generate Platform Contract') {

            steps {

                sh '''
                    set -euo pipefail

                    chmod +x platform-ci/bin/platform
                    chmod +x platform-ci/lib/*.sh

                    ./platform-ci/bin/platform \
                        generate-contract

                    echo ""
                    echo "Generated platform contract:"
                    cat platform-contract.json
                '''
            }
        }


        stage('Publish Platform Contract') {

            steps {

                sh '''
                    set -euo pipefail

                    ARTIFACT_BUCKET=$(
                        cat "${WORKSPACE}/.platform_artifact_bucket"
                    )

                    if [ -z "${ARTIFACT_BUCKET}" ]; then

                        echo "ERROR: Platform artifact bucket is empty."

                        exit 1
                    fi

                    export PLATFORM_ARTIFACT_BUCKET="${ARTIFACT_BUCKET}"

                    export PLATFORM_CONTRACT_KEY="platform-contract/${PLATFORM_ENV}/service-contract.json"

                    chmod +x platform-ci/bin/platform
                    chmod +x platform-ci/lib/*.sh

                    ./platform-ci/bin/platform \
                        publish-contract
                '''
            }
        }


        stage('Build Docker Image') {

            steps {

                script {

                    echo "Docker image build will use the service runtime contract."

                    echo "Service directory:"
                    echo "${params.SERVICE_DIR}"

                    echo "Runtime:"
                    echo "${env.SERVICE_RUNTIME}"

                    /*
                     * Application image build intentionally remains
                     * separate from platform contract generation.
                     *
                     * The platform CI pipeline currently proves:
                     *
                     * 1. Service contract
                     * 2. Runtime contract
                     * 3. Platform environment resolution
                     * 4. Platform contract generation
                     * 5. Platform contract publication
                     *
                     * Application image publishing can be connected
                     * here after the platform handoff is validated.
                     */
                }
            }
        }
    }


    post {

        always {

            sh '''
                rm -rf platform-environment-gitops
                rm -f .platform_artifact_bucket
            '''

            cleanWs()
        }

        success {

            echo "Platform CI pipeline completed successfully."
        }

        failure {

            echo "Platform CI pipeline failed."
        }
    }
}
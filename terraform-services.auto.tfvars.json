{
  "services": {
    "auth-service": {
      "runtime": "spring-boot",
      "team": "identity",
      "persistence": {
        "enabled": true,
        "mode": "new",
        "engine": "postgres",
        "size": "small",
        "database_name": "authdb",
        "access": null
      },
      "migration": {
        "enabled": true,
        "engine": "flyway"
      }
    },
    "orders-service": {
      "runtime": "nodejs",
      "team": "commerce",
      "persistence": {
        "enabled": true,
        "mode": "new",
        "engine": "postgres",
        "size": "small",
        "database_name": "ordersdb",
        "access": null
      },
      "migration": {
        "enabled": true,
        "engine": "flyway"
      }
    },
    "payments-service": {
      "runtime": "nodejs",
      "team": "payments",
      "persistence": {
        "enabled": true,
        "mode": "new",
        "engine": "postgres",
        "size": "small",
        "database_name": "paymentsdb",
        "access": null
      },
      "migration": {
        "enabled": true,
        "engine": "flyway"
      }
    },
    "payments-spring-service": {
      "runtime": "spring-boot",
      "team": "payments",
      "persistence": {
        "enabled": false,
        "mode": "none",
        "engine": null,
        "size": null,
        "database_name": null,
        "access": null
      },
      "migration": {
        "enabled": false,
        "engine": null
      }
    }
  }
}
